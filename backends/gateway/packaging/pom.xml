<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <artifactId>thmpoc-gateway-packaging</artifactId>
    <build>
        <finalName>thmpoc-gateway-${project.version}</finalName>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <groupId>org.apache.maven.plugins</groupId>
            </plugin>
            <plugin>
                <artifactId>maven-jlink-plugin</artifactId>
                <configuration>
                    <includeLocales>
                        <includeLocale>en</includeLocale>
                        <includeLocale>it</includeLocale>
                    </includeLocales>
                    <launcher>thmpoc=thmpoc.gateway</launcher>
                    <noHeaderFiles>true</noHeaderFiles>
                    <noManPages>true</noManPages>
                    <stripDebug>true</stripDebug>
                </configuration>
                <extensions>true</extensions>
                <groupId>org.apache.maven.plugins</groupId>
                <version>3.3.0</version>
            </plugin>
        </plugins>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <excludes>
                    <exclude>.gitkeep</exclude>
                </excludes>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
                <excludes>
                    <exclude>.gitkeep</exclude>
                </excludes>
            </testResource>
        </testResources>
    </build>
    <dependencies>
        <dependency>
            <artifactId>thmpoc-gateway-project</artifactId>
            <groupId>eu.eklexis.thmpoc</groupId>
            <version>0.1.0-SNAPSHOT</version>
        </dependency>
    </dependencies>
    <groupId>eu.eklexis.thmpoc</groupId>
    <modelVersion>4.0.0</modelVersion>
    <name>ThmPOC - Gateway (Packaging)</name>
    <packaging>jlink</packaging>
    <parent>
        <artifactId>thmpoc-gateway</artifactId>
        <groupId>eu.eklexis.thmpoc</groupId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
</project>